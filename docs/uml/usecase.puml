@startuml
left to right direction

actor User

rectangle "Color Manager Application" {
    usecase "Log In" as UC1
    usecase "Log Out" as UC2
    usecase "Add Color" as UC3
    usecase "Search Color" as UC4
    usecase "Verify Authentication" as UC5
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4

UC1 ..> UC5 : <<include>>
UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>
@enduml